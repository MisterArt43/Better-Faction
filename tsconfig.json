{
   "compilerOptions": {
      "target": "ES2020",
      "moduleResolution": "Node",
      "module": "ES2020",
      "declaration": false,
      "noLib": false,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": false,
      "pretty": true,
      "forceConsistentCasingInFileNames": true,
      "strict": true,
      "allowUnreachableCode": true,
      "allowUnusedLabels": true,
      "allowJs": false,
      "noImplicitAny": true,
      "noImplicitReturns": false,
      "noImplicitUseStrict": false,
      "outDir": "./scripts",
      "rootDir": "./dev-scripts",
      "baseUrl": "behavior_packs/",
      "listFiles": true,
      "noEmitHelpers": true,
      "skipLibCheck": true
   },
   "include": [
      "dev-scripts/**/*",
   ],
   "exclude": [
      "lib",
      "dist",
      "node_modules"
   ],
   "compileOnSave": false
}